let count = 0

const cc = (card) => {
  if (card >= 2 && card <= 6) {
    count++; // Cartas bajas: +1
  } else if (card >= 7 && card <= 9) {
    // Cartas neutrales: 0 (No se hace nada)
  } else {
    // Cartas altas (10, J, Q, K, A): -1
    count--; 
  }

  if (count > 0) {
    return `${count}` + " Bet";
  } else if (count <= 0){
    return `${count}` + " Hold";
  }
}
